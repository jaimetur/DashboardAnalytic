CONTAINER_NAME=drivetest-analyzer
IMAGE_REPOSITORY=jaimetur/drivetest-analyzer
IMAGE_TAG=latest        # you can use an specific tag name such as 0.1.0

APP_NAME=DriveTest Analyzer
APP_PORT=7278
APP_DEV_PORT=7279
APP_SECRET_KEY=change-me-drivetest-analyzer
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin123

# Override the project-root storage-paths.conf values inside the container.
APP_CONFIG_DIR=/app/config
APP_DATA_DIR=/app/data
APP_ASSETS_DIR=/app/assets

# Change those fields to use your local paths (absolute paths)
HOST_CONFIG_DIR=./config
HOST_DATA_DIR=./data

# IANA timezone used by the container for displayed and persisted timestamps.
TZ=Europe/Madrid
