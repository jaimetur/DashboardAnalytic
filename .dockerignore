# Evita incluir archivos innecesarios en la imagen Docker

# Entornos virtuales
.venv_macmini/
.venv_mac/
.venv_macmini/
.venv_macbook/
.venv_windows/
venv/
.env/

# Archivos temporales y de sistema
*.pyc
__pycache__/
.DS_Store

# Archivos de control de Git
.git
.gitignore

# Archivos ZIP de releases
*.zip

# Workflows de GitHub
.github/

# Runtime data and development-only files are never copied by the Dockerfile.
# Excluding them also prevents multi-GB workspace databases from being sent to
# the Docker daemon when validating or building locally.
config/
data/
dist/
tests/
.idea/

